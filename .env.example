PORT=5000
NODE_ENV=development

# MongoDB (local or Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/campustrace

# JWT Secret (use a long random string in production)
JWT_SECRET=your_jwt_secret_here

# Image storage: "local" (disk) or "cloudinary"
STORAGE_MODE=local

# Cloudinary Credentials (required only when STORAGE_MODE=cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Optional: seed admin on startup (Docker sets this to true)
# SEED_ADMIN=true
# SEED_ADMIN_EMAIL=admin@campustrace.local
# SEED_ADMIN_PASSWORD=123456
